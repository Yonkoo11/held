# Copy this to a real environment file and fill it in. Never paste real keys into a chat.
# Without the Hedera values the app runs on its local stand-in tier and says so on every receipt.
#
# Keep it chmod 600. Verify the whole setup any time with:  npm run check:secrets

# ---------------------------------------------------------------------------------------------
# STEP 1 — the only thing that needs a human.
#
#   https://portal.hedera.com/register — free, instant, auto-funded with test HBAR.
#   Create a TESTNET account and copy BOTH values below from the SAME account.
#
#   Any key format works: ECDSA or ED25519, DER or raw hex, with or without an 0x prefix.
#   The portal issues ECDSA by default. Do not try to work out which you have — the app asks
#   the ledger what key that account actually uses, parses to match, and refuses to start if
#   the key you supplied does not derive that account's public key.
# ---------------------------------------------------------------------------------------------

HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=

# ---------------------------------------------------------------------------------------------
# STEP 2 — from inside the project directory, run:  npm run go-live
#
# It fills in everything below on its own and prints only public account ids.
# It also prints the BUYER account id and pauses, so you can claim test USDC for it at
# https://faucet.circle.com — choose "Hedera Testnet", paste the 0.0.x id. 20 USDC per 2 hours.
# ---------------------------------------------------------------------------------------------

HEDERA_ESCROW_ID=
HEDERA_ESCROW_KEY=
HEDERA_BUYER_ID=
HEDERA_BUYER_KEY=
SELLER_ACCOUNT_ID=
HCS_TOPIC_ID=

# hbar (default, needs nothing extra) or usdc (stronger demo, needs the faucet step above).
# go-live sets this for you depending on whether the USDC actually arrived.
PAY_ASSET=hbar

# ---------------------------------------------------------------------------------------------
# Optional. Leave blank to use whatever is already in your shell environment.
# The worker falls back Anthropic -> OpenAI -> Gemini -> local ollama -> no model at all, and
# stamps which one ran on every receipt. A blank key costs a tier, never the demo.
# ---------------------------------------------------------------------------------------------

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------------------------------
# Service settings. No secrets below this line.
# ---------------------------------------------------------------------------------------------

FACILITATOR_URL=https://api.testnet.blocky402.com
PRICE=0.05
REVIEW_MINUTES=10
PORT=4021
MAX_QUESTION_CHARS=2000

# Lets the web page buy using THIS SERVER'S OWN funded account. Fine against the local stand-in.
# On a live tier with a public URL this drains the account, so it stays off unless you set it.
# DEMO_BUY=on
