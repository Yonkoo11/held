{
  "name": "held",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "2.85.0",
    "@x402/core": "^2.25.0",
    "@x402/fetch": "^2.25.0",
    "@x402/hedera": "^2.25.0",
    "express": "^5.2.1"
  },
  "scripts": {
    "start": "node src/seller.js",
    "seller": "node --env-file-if-exists=.env --env-file-if-exists=\"$HOME/.outcomelock.env\" src/seller.js",
    "buyer": "node --env-file-if-exists=.env --env-file-if-exists=\"$HOME/.outcomelock.env\" src/buyer.js",
    "go-live": "node --env-file-if-exists=.env --env-file-if-exists=\"$HOME/.outcomelock.env\" scripts/go-live.js",
    "prove": "node --env-file-if-exists=.env --env-file-if-exists=\"$HOME/.outcomelock.env\" scripts/prove-live.js",
    "attack": "node scripts/attack.js",
    "dryrun": "node scripts/dryrun-hedera.js",
    "check:secrets": "node scripts/check-secrets.js",
    "postinstall": "node scripts/install-hooks.js || true",
    "regression": "node scripts/regression.js",
    "test": "node scripts/dryrun-hedera.js && node scripts/test-keys.js && node scripts/test-worker.js && node scripts/regression.js",
    "test:keys": "node scripts/test-keys.js",
    "test:worker": "node scripts/test-worker.js",
    "design:check": "bash ~/System/scripts/ui-slop-check.sh .",
    "prove:contract": "node --env-file-if-exists=.env --env-file-if-exists=\"$HOME/.outcomelock.env\" scripts/prove-contract.js",
    "test:contract": "cd contracts && forge test"
  }
}
