{
  "name": "held-video",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/Root.tsx",
    "render": "remotion render src/Root.tsx Main out/demo.mp4 --concurrency 4",
    "typecheck": "tsc --noEmit",
    "timings": "npm run --silent frames && node scripts/sync-timings.mjs",
    "frames": "tsx scripts/dump-frames.mts"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.524",
    "@remotion/google-fonts": "^4.0.524",
    "@remotion/transitions": "^4.0.524",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.524"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
